{
  "id": "agent-wallet",
  "name": "PayGents",
  "version": "0.1.0",
  "description": "OpenClaw tools for the PayGents backend (/api/commands).",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "minLength": 1,
        "description": "PayGents backend base URL (e.g. https://agent-wallet-demo-production.up.railway.app)."
      },
      "apiKey": {
        "type": "string",
        "minLength": 1,
        "description": "PayGents API key for bot-facing endpoints. In hosted mode, get it from POST /api/register. In legacy mode, use AGENT_WALLET_API_KEY."
      },
      "timeoutMs": {
        "type": "number",
        "minimum": 1000,
        "maximum": 60000,
        "default": 15000,
        "description": "HTTP timeout for PayGents API calls."
      }
    },
    "required": ["baseUrl"]
  },
  "uiHints": {
    "apiKey": {
      "secret": true
    }
  },
  "skills": ["skills/agent-wallet"]
}
