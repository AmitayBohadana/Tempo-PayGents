{
  "id": "agent-wallet",
  "name": "Agent Wallet",
  "version": "0.1.0",
  "description": "OpenClaw tools for the Human-Verified Agent Wallet backend (/api/commands).",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "minLength": 1,
        "description": "Agent Wallet backend base URL (e.g. https://agent-wallet-demo-production.up.railway.app)."
      },
      "apiKey": {
        "type": "string",
        "minLength": 1,
        "description": "Optional Agent Wallet API key (AGENT_WALLET_API_KEY). Sent as Authorization: Bearer <apiKey>."
      },
      "timeoutMs": {
        "type": "number",
        "minimum": 1000,
        "maximum": 60000,
        "default": 15000,
        "description": "HTTP timeout for Agent Wallet API calls."
      }
    },
    "required": ["baseUrl"]
  },
  "uiHints": {
    "apiKey": {
      "secret": true
    }
  },
  "skills": ["skills/agent-wallet"]
}

